{
  "name": "mendai",
  "version": "0.1.4",
  "description": "Autonomous AI maintainer for Node, Laravel and other projects: finishes incomplete work, fixes failing code, and implements module-wise requirement files. Claude by default, with automatic fallback to free models when tokens run out.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "mendai": "bin/mendai.js"
  },
  "files": [
    "bin",
    "src",
    "stubs",
    "skills",
    "README.md",
    "SETUP.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check bin/mendai.js && for f in src/*.js src/**/*.js; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "anthropic",
    "laravel",
    "node",
    "autonomous",
    "code-fix",
    "requirements",
    "todo",
    "agent-skills",
    "skill",
    "codex",
    "antigravity",
    "claude-code"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0"
  },
  "author": "iftekharmahmudhimu-coder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iftekharmahmudhimu-coder/mendai.git"
  },
  "homepage": "https://github.com/iftekharmahmudhimu-coder/mendai#readme",
  "bugs": {
    "url": "https://github.com/iftekharmahmudhimu-coder/mendai/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
